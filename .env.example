# WhatsApp Auto-Approver Environment Configuration
# Copy this to .env.production and fill in your values

# ===== REQUIRED =====

# GrowthX API Bearer Token
# Get from your GrowthX dashboard
GROWTHX_API_KEY=Bearer_your_token_here

# Google Sheet ID (the long ID in the URL)
# Example: https://docs.google.com/spreadsheets/d/1axEuQqoaGT6b5.../edit
SHEET_ID=1axEuQqoaGT6b5niI5lk_MHERyTVLDx9OjqjhVPEZOjk

# Google Sheet CSV Export URL (groups config, gid=0)
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/1axEuQqoaGT6b5niI5lk_MHERyTVLDx9OjqjhVPEZOjk/export?format=csv&gid=0

# Alternate Numbers Sheet CSV URL (gid=1339372007)
ALTERNATE_NUMBERS_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/1axEuQqoaGT6b5niI5lk_MHERyTVLDx9OjqjhVPEZOjk/export?format=csv&gid=1339372007

# ===== OPTIONAL: ALERTING =====

# Telegram Bot Token (get from @BotFather)
# Leave empty to disable Telegram alerts
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID (your user ID from bot)
# Get by sending /start to your bot and fetching updates
TELEGRAM_CHAT_ID=

# Generic webhook URL (Slack incoming webhook, n8n, Zapier, etc.)
# Leave empty to disable webhook alerts
ALERT_WEBHOOK_URL=

# ===== OPTIONAL: ROSTER INTEGRATION =====

# Apps Script Web App URL (if you set up sheet integration)
# Deploy roster-appscript.gs and copy the URL here
ROSTER_WEBHOOK_URL=

# ===== VPS DEPLOYMENT =====

# Set to true when deploying to VPS (headless mode)
HEADLESS=true

# Path to Chromium/Chrome executable (VPS only)
# Linux: /usr/bin/chromium-browser
# macOS: /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome
CHROMIUM_PATH=/usr/bin/chromium-browser

# ===== OPTIONAL: DEBUGGING =====

# Set to 'debug' to see verbose logs
LOG_LEVEL=info

# DRY_RUN mode (logs approvals but doesn't actually approve)
# Useful for testing — set to false in production
DRY_RUN=false
